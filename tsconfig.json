{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationDir": "./lib",
    "rootDir": "./lib/src",
    "jsx": "react-jsx",
    "outDir": "./lib",
    "allowJs": true
  },
  "include": ["lib/src/**/*"],
  "exclude": ["node_modules", "dist", "example"]
}
