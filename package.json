{
  "name": "@alvinahmad/blueprin-sdk",
  "version": "1.0.1",
  "description": "Official SDK for building plugins, connectors, extensions and integrations for Blueprin",
  "main": "lib/index.js",
  "module": "lib/index.mjs",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.mjs",
      "require": "./lib/index.js"
    },
    "./core": {
      "types": "./lib/core/index.d.ts",
      "import": "./lib/core/index.mjs",
      "require": "./lib/core/index.js"
    },
    "./hooks": {
      "types": "./lib/hooks/index.d.ts",
      "import": "./lib/hooks/index.mjs",
      "require": "./lib/hooks/index.js"
    },
    "./events": {
      "types": "./lib/events/index.d.ts",
      "import": "./lib/events/index.mjs",
      "require": "./lib/events/index.js"
    },
    "./ui": {
      "types": "./lib/ui/index.d.ts",
      "import": "./lib/ui/index.mjs",
      "require": "./lib/ui/index.js"
    },
    "./connector": {
      "types": "./lib/connector/index.d.ts",
      "import": "./lib/connector/index.mjs",
      "require": "./lib/connector/index.js"
    },
    "./storage": {
      "types": "./lib/storage/index.d.ts",
      "import": "./lib/storage/index.mjs",
      "require": "./lib/storage/index.js"
    },
    "./project": {
      "types": "./lib/project/index.d.ts",
      "import": "./lib/project/index.mjs",
      "require": "./lib/project/index.js"
    },
    "./material": {
      "types": "./lib/material/index.d.ts",
      "import": "./lib/material/index.mjs",
      "require": "./lib/material/index.js"
    },
    "./rab": {
      "types": "./lib/rab/index.d.ts",
      "import": "./lib/rab/index.mjs",
      "require": "./lib/rab/index.js"
    },
    "./schedule": {
      "types": "./lib/schedule/index.d.ts",
      "import": "./lib/schedule/index.mjs",
      "require": "./lib/schedule/index.js"
    },
    "./marketplace": {
      "types": "./lib/marketplace/index.d.ts",
      "import": "./lib/marketplace/index.mjs",
      "require": "./lib/marketplace/index.js"
    },
    "./report": {
      "types": "./lib/report/index.d.ts",
      "import": "./lib/report/index.mjs",
      "require": "./lib/report/index.js"
    },
    "./workforce": {
      "types": "./lib/workforce/index.d.ts",
      "import": "./lib/workforce/index.mjs",
      "require": "./lib/workforce/index.js"
    },
    "./telemetry": {
      "types": "./lib/telemetry/index.d.ts",
      "import": "./lib/telemetry/index.mjs",
      "require": "./lib/telemetry/index.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "import": "./lib/client/index.mjs",
      "require": "./lib/client/index.js"
    },
    "./webhook": {
      "types": "./lib/webhook/index.d.ts",
      "import": "./lib/webhook/index.mjs",
      "require": "./lib/webhook/index.js"
    },
    "./openrouter": {
      "types": "./lib/openrouter/index.d.ts",
      "import": "./lib/openrouter/index.mjs",
      "require": "./lib/openrouter/index.js"
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "lib/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "blueprin",
    "sdk",
    "plugin",
    "connector",
    "construction",
    "budgeting",
    "rab",
    "material",
    "marketplace"
  ],
  "author": "qalvinahmad",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/qalvinahmad/blueprin-sdk"
  },
  "homepage": "https://github.com/qalvinahmad/blueprin-sdk#readme",
  "bugs": {
    "url": "https://github.com/qalvinahmad/blueprin-sdk/issues"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitest/coverage-v8": "^3.2.7",
    "esbuild": "^0.28.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.8.3",
    "vitest": "^3.2.1"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "glob": "^13.0.6"
  }
}
